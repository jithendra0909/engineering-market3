PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/engineering-market
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=https://engineering-market.in

# SMTP Email Configuration (Used for password reset & email notifications)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Cloudinary Credentials (Used for product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# WhatsApp Cloud API Credentials (Optional, required for seller WhatsApp instant notifications)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_TEMPLATE_NAME=new_message_alert
WHATSAPP_TEMPLATE_LANG=en_US

# Web Push Notifications (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:support@engineering-market.in
